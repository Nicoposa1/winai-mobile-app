{
  "expo": {
    "name": "WinAI - Wine Companion",
    "slug": "winai-wine-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "winai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Your intelligent wine companion. Discover, rate, and manage your wine collection with the power of AI. Perfect for wine enthusiasts and beginners alike.",
    "keywords": ["wine", "AI", "cellar", "rating", "collection", "tasting", "recommendations"],
    "privacy": "public",
    "githubUrl": "https://github.com/yourusername/winai-mobile-app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicoposa1.winai",
      "appleTeamId": "RLCVG58Z8Z",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "WinAI uses the camera to scan wine labels and add wines to your collection.",
        "NSPhotoLibraryUsageDescription": "WinAI accesses your photo library to import wine images and photos.",
        "NSFaceIDUsageDescription": "WinAI uses Face ID for secure authentication and quick access to your account."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nicoposa1.winai",
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.nicoposa1.winai"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID for secure authentication."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://winai.app/privacy-policy",
      "termsOfServiceUrl": "https://winai.app/terms-of-service",
      "supportUrl": "https://winai.app/support",
      "websiteUrl": "https://winai.app",
      "supportEmail": "support@winai.app",
      "companyName": "WinAI Team",
      "appStoreUrls": {
        "ios": "https://apps.apple.com/app/winai",
        "android": "https://play.google.com/store/apps/details?id=com.nicoposa1.winai"
      }
    }
  }
}
